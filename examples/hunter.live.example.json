{
  "version": 1,
  "allowedHosts": [
    "monitor.example.com"
  ],
  "checks": [
    {
      "id": "orders-pulse",
      "mode": "pulse",
      "source": {
        "kind": "https",
        "url": "https://monitor.example.com/ghost/pulse/orders",
        "tokenEnv": "GHOST_HUNTER_TOKEN"
      },
      "openAfter": 2,
      "resolveAfter": 2
    },
    {
      "id": "warehouse-pulse",
      "mode": "pulse",
      "source": {
        "kind": "https",
        "url": "https://monitor.example.com/ghost/pulse/warehouse",
        "tokenEnv": "GHOST_HUNTER_TOKEN"
      },
      "openAfter": 2,
      "resolveAfter": 2
    }
  ]
}
