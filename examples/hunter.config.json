{
  "version": 1,
  "allowedHosts": [],
  "checks": [
    {
      "id": "orders-pulse",
      "mode": "pulse",
      "source": {
        "kind": "file",
        "path": "pulse-suspected.json"
      },
      "openAfter": 2,
      "resolveAfter": 2
    },
    {
      "id": "bulk-impact",
      "mode": "impact",
      "source": {
        "kind": "file",
        "path": "impact-blocked.json"
      },
      "openAfter": 2,
      "resolveAfter": 2
    },
    {
      "id": "release-status",
      "mode": "release",
      "source": {
        "kind": "file",
        "path": "release-unverified.json"
      },
      "openAfter": 2,
      "resolveAfter": 2
    },
    {
      "id": "environment",
      "mode": "environment",
      "source": {
        "kind": "file",
        "path": "environment-mismatch.json"
      },
      "openAfter": 2,
      "resolveAfter": 2
    }
  ]
}
